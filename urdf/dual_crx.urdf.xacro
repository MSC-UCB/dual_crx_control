<?xml version="1.0"?>
<robot name="dual_crx" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:arg name="enable_left" default="true"/>
  <xacro:arg name="enable_right" default="true"/>
  <xacro:arg name="left_xyz" default="0 0 0"/>
  <xacro:arg name="left_rpy" default="0 0 0"/>
  <!-- Previous right arm base calibration:
  <xacro:arg name="right_xyz" default="0.02243080 -0.67894529 0.01039634"/>
  <xacro:arg name="right_rpy" default="0.00662890 -0.02062080 -1.55552523"/>
  -->
  <xacro:arg name="right_xyz" default="0.03058936 -0.91156264 0.00873476"/>
  <xacro:arg name="right_rpy" default="0.00994493 -0.01029918 -1.54694055"/>
  <xacro:arg name="table_collision_size" default="0.30"/>

  <xacro:include filename="$(find fanuc_crx_description)/urdf/crx5ia_urdf_macro.xacro"/>

  <link name="world"/>
  <link name="table_frame"/>
  <joint name="world_to_table" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="table_frame"/>
  </joint>

  <link name="calibration_table_surface">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="$(arg table_collision_size) $(arg table_collision_size) 0.04"/>
      </geometry>
      <material name="calibration_table_gray">
        <color rgba="0.45 0.45 0.45 0.45"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="$(arg table_collision_size) $(arg table_collision_size) 0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="table_to_calibration_surface" type="fixed">
    <parent link="table_frame"/>
    <child link="calibration_table_surface"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:if value="$(arg enable_left)">
    <link name="left_ee_mount"/>
    <xacro:crx5ia prefix="left_" parent="world" child="left_ee_mount">
      <origin xyz="$(arg left_xyz)" rpy="$(arg left_rpy)"/>
    </xacro:crx5ia>

    <link name="left_tcp"/>
    <joint name="left_ee_to_tcp" type="fixed">
      <parent link="left_ee_mount"/>
      <child link="left_tcp"/>
      <origin xyz="0.035 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <xacro:if value="$(arg enable_right)">
    <link name="right_ee_mount"/>
    <xacro:crx5ia prefix="right_" parent="world" child="right_ee_mount">
      <origin xyz="$(arg right_xyz)" rpy="$(arg right_rpy)"/>
    </xacro:crx5ia>

    <link name="right_tcp"/>
    <joint name="right_ee_to_tcp" type="fixed">
      <parent link="right_ee_mount"/>
      <child link="right_tcp"/>
      <origin xyz="0.035 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>
</robot>
